# Variables de entorno del backend (Lambdas) y de Prisma.
#
# Copiar a .env en la raíz y completar. Nunca commitear valores reales.
#
# Las variables del frontend van aparte, en frontend/.env.example. Ninguna de
# estas debe copiarse allá con prefijo NEXT_PUBLIC_: terminaría en el bundle
# del navegador.

# --- Supabase -----------------------------------------------------------------

# URL del proyecto de Supabase.
# Supabase -> Project Settings -> API -> Project URL.
# Pública.
SUPABASE_URL=https://your-project-ref.supabase.co

# Clave anon de Supabase. Las Lambdas la usan junto al token del usuario para
# que RLS se aplique en cada query.
# Supabase -> Project Settings -> API -> Project API keys -> anon public.
# Pública.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Clave service_role de Supabase. Saltea RLS: usar solo en procesos sin usuario
# (por ejemplo, el chequeo programado de alertas) o para escribir price_cache,
# que es compartida; nunca para datos de un usuario ni en el frontend.
# Sin ella, el dashboard trae precios de las APIs pero no los cachea.
# Supabase -> Project Settings -> API -> Project API keys -> service_role.
# SECRETA.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Prisma -------------------------------------------------------------------

# Connection string directo de Postgres. Solo para Prisma (schema, migraciones
# y tipos), nunca para queries en runtime: no lleva contexto de sesión y
# saltearía RLS.
# Supabase -> Project Settings -> Database -> Connection string -> URI.
# SECRETA (incluye la contraseña de la base).
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# --- IA (Groq) ----------------------------------------------------------------

# API key de Groq para el modelo LLM que genera los insights.
# console.groq.com -> API Keys -> Create API Key.
# SECRETA.
GROQ_API_KEY=your-groq-api-key

# Modelo de Groq para el insight. Opcional: por defecto llama-3.3-70b-versatile.
# Modelos disponibles: console.groq.com -> Models.
# Pública.
GROQ_MODEL=llama-3.3-70b-versatile

# --- Web Push (VAPID) ---------------------------------------------------------

# Par de claves VAPID para firmar las notificaciones push.
# Generar una vez con: npx web-push generate-vapid-keys
# La pública también la necesita el navegador al suscribirse.
# Pública.
VAPID_PUBLIC_KEY=your-vapid-public-key

# Clave privada del mismo par.
# Salida de: npx web-push generate-vapid-keys
# SECRETA.
VAPID_PRIVATE_KEY=your-vapid-private-key

# Contacto que se informa a los servicios push, como mailto: o URL https.
# Lo define el equipo.
# Pública.
VAPID_SUBJECT=mailto:contacto@example.com

# --- AWS ----------------------------------------------------------------------

# Región donde se despliega el stack (Lambdas, API Gateway, EventBridge).
# Debe coincidir con samconfig.toml y con la variable de repositorio AWS_REGION.
# Pública.
AWS_REGION=us-east-2
