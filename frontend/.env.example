# Variables de entorno del frontend (Next.js).
#
# Para desarrollo local no hace falta copiarlo a mano: `node scripts/setup-env.mjs`
# (desde la raíz) genera frontend/.env.local con los valores del repo en GitHub.
# Ver "Desarrollo local" en readme.md. Nunca commitear valores reales.
#
# Todo lo que lleva prefijo NEXT_PUBLIC_ se incrusta en el bundle del navegador,
# así que acá van SOLO valores públicos. Los secretos viven en el .env de la raíz
# (backend / Prisma) y nunca deben llevar este prefijo.
#
# En el deploy (.github/workflows/deploy.yml) se toman de las variables de
# repositorio API_URL, SUPABASE_URL y SUPABASE_ANON_KEY.

# URL base del API (API Gateway + Lambda). En local, el servidor de desarrollo
# del backend (`npm run dev` en backend/, puerto 3001, para no chocar con
# `next dev` en el 3000); en producción, la salida del stack de SAM.
# Pública.
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL del proyecto de Supabase.
# Supabase -> Project Settings -> API -> Project URL.
# Pública.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clave anon de Supabase. Es pública por diseño: RLS es lo que protege los datos.
# Supabase -> Project Settings -> API Keys -> Publishable key (sb_publishable_...).
# La anon legacy (JWT eyJ...) también funciona hasta que Supabase la retire.
# Pública.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
