# Variables de entorno del frontend (Next.js).
#
# Copiar a frontend/.env.local y completar. Nunca commitear valores reales.
#
# Todo lo que lleva prefijo NEXT_PUBLIC_ se incrusta en el bundle del navegador,
# así que acá van SOLO valores públicos. Los secretos viven en el .env de la raíz
# (backend / Prisma) y nunca deben llevar este prefijo.
#
# En el deploy (.github/workflows/deploy.yml) se toman de las variables de
# repositorio API_URL, SUPABASE_URL y SUPABASE_ANON_KEY.

# URL base del API (API Gateway + Lambda). En local, la que expone
# `sam local start-api`; en producción, la salida del stack de SAM.
# Pública.
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL del proyecto de Supabase.
# Supabase -> Project Settings -> API -> Project URL.
# Pública.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clave anon de Supabase. Es pública por diseño: RLS es lo que protege los datos.
# Supabase -> Project Settings -> API -> Project API keys -> anon public.
# Pública.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
