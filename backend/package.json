{
  "name": "stonksview-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "esbuild src/dev/server.ts --bundle --platform=node --format=esm --target=es2022 --packages=external --outfile=.dev/server.mjs --log-level=warning && node --env-file-if-exists=../.env .dev/server.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
